{
  "version": 2,
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "packages/frontend/dist",
  "functions": {
    "api/code/run.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/code/run",
      "destination": "https://prep-os-backend.vercel.app/api/code/run"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

